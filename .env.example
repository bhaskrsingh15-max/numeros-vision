# ==============================================================================
# NUMEROS VISION — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# IMPORTANT: Never commit actual secret keys, API tokens, or credentials here.
# Copy this file to .env and populate with server-side environment variables.
# ==============================================================================

# Server & Application Configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
SECRET_KEY=
SESSION_ENCRYPTION_KEY=

# Google GenAI / Gemini Image Generation (Server-Side Only)
# Official Docs: https://ai.google.dev/gemini-api/docs/image-generation
GOOGLE_GENAI_API_KEY=
GOOGLE_IMAGE_MODEL_ID=imagen-3.0-generate-002
GOOGLE_IMAGE_FALLBACK_MODEL_ID=imagen-3.0-generate-002
GOOGLE_IMAGE_GENERATION_TIMEOUT_SECONDS=45
GOOGLE_IMAGE_MAX_RETRIES=2
GOOGLE_IMAGE_MAX_CONCURRENT_JOBS=5

# Cost & Quota Controls (Section 17.9)
MAX_DAILY_IMAGE_GENERATION_BUDGET_USD=50.00
MAX_PER_USER_DAILY_REVISIONS=3
IMAGE_GENERATION_ESTIMATED_COST_USD=0.030

# Redis & Caching (Optional, in-memory fallback enabled if absent)
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# SMS & Email Dual-Channel Same-OTP Verification Service (Brevo: Email + Optional +91 Transactional SMS)
EMAIL_PROVIDER=brevo
EMAIL_API_KEY=
BREVO_API_KEY=
# Required for SMS: approved alphanumeric sender ID (3-11 chars, e.g. DLT-registered header). If blank/invalid, SMS is skipped ("sms_skipped: no sender").
BREVO_SMS_SENDER=
BREVO_SMS_TEMPLATE=
BREVO_SMS_ORG_PREFIX=
SMS_DAILY_CAP=25
OTP_MOBILE_RATE_LIMIT=3
OTP_EMAIL_RATE_LIMIT=5
OTP_IP_RATE_LIMIT=10
EMAIL_DAILY_CAP=500
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional SMTP Relay
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=support@numerosvision.com
EMAIL_SMTP_PASSWORD=

# Identity & DPDP 2023 Consent Ledger
DPDP_CONSENT_AUDIT_LOG_PATH=data/consent_ledger.jsonl
DPDP_TENANT_ISOLATION_ENFORCED=true

# Storage & Asset Retention Policy
ASSET_STORAGE_ROOT=data/secure_assets
CUSTOMER_ASSET_RETENTION_DAYS=90
TEMP_ASSET_RETENTION_HOURS=24
EMAIL_FROM="Numeros Vision <support@numerosvision.com>"
