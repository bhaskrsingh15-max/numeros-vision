          "plane_col": "Will"
        },
        "2": {
          "row": 0,
          "col": 2,
          "plane_row": "Mental",
          "plane_col": "Action"
        },
        "3": {
          "row": 1,
          "col": 0,
          "plane_row": "Emotional",
          "plane_col": "Thought"
        },
        "5": {
          "row": 1,
          "col": 1,
          "plane_row": "Emotional",
          "plane_col": "Will"
        },
        "7": {
          "row": 1,
          "col": 2,
          "plane_row": "Emotional",
          "plane_col": "Action"
        },
        "8": {
          "row": 2,
          "col": 0,
          "plane_row": "Practical",
          "plane_col": "Thought"
        },
        "1": {
