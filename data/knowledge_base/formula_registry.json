          "plane_row": "Practical",
          "plane_col": "Will"
        },
        "6": {
          "row": 2,
          "col": 2,
          "plane_row": "Practical",
          "plane_col": "Action"
        }
      },
      "steps": [
        "Count frequency of each digit 1 through 9 from the supplied digits list (0 is ignored as having no cell).",
        "Check 8 planes for full presence (strength) or complete absence (weakness):",
        "  - Horizontal Planes: Mental (4,9,2), Emotional (3,5,7), Practical (8,1,6)",
        "  - Vertical Planes: Thought (4,3,8), Will (9,5,1), Action (2,7,6)",
        "  - Diagonal Planes: Golden Raj Yoga (4,5,6), Silver Property (2,5,8)",
        "Identify missing numbers (frequency == 0) and excessive numbers (frequency >= 3)."
      ],
      "reduction_policy": "frequency_histogram",
      "special_cases": [
        "Digit 0 has no cell in the Lo Shu 3x3 square."
      ],
      "output_schema": {
        "digit_counts": "object",
        "present_planes": "array of strings",
        "absent_planes": "array of strings",
        "missing_digits": "array of integers"
      },
