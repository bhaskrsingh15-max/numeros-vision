      "formula_id": "loshu.grid_and_planes.v1",
      "tradition": "Chinese",
      "topic": "grid_analysis",
      "name": "Lo Shu 3x3 Magic Square Frequency & Plane Analysis",
      "inputs": [
        {
          "name": "dob_digits",
