    {
      "formula_id": "chaldean.name.compound_and_root.v1",
      "tradition": "Chaldean",
      "topic": "name_analysis",
      "name": "Chaldean Name Compound and Root Calculation",
      "inputs": [
        {
          "name": "name",
          "type": "string",
          "required": true,
          "description": "Full calling name, first name, or business brand name"
        }
      ],
      "normalization_policy": "strip_accents_uppercase_ascii_alpha_only",
      "mapping_id": "chaldean.letter_values.v1",
      "mapping": {
        "A": 1,
        "I": 1,
        "J": 1,
        "Q": 1,
        "Y": 1,
        "B": 2,
        "C": 2,
        "K": 2,
        "R": 2,
        "G": 3,
        "L": 3,
        "S": 3,
        "D": 4,
        "M": 4,
        "T": 4,
        "E": 5,
        "H": 5,
        "N": 5,
        "X": 5,
        "U": 6,
        "V": 6,
        "W": 6,
        "O": 7,
        "Z": 7,
        "F": 8,
        "P": 8
      },
      "steps": [
        "Normalize input name to uppercase ASCII alphabetic characters (A-Z). Spaces and non-alpha characters are ignored for value sum.",
        "Map each character to its Chaldean digit (1-8).",
        "Sum individual letter values to produce compound_total.",
        "Sum digits of compound_total iteratively until a single digit (1-9) is reached to produce root_number.",
        "Preserve compound_total as primary esoteric vibration; root_number as base planetary ruler."
      ],
      "reduction_policy": "preserve_compound_then_reduce",
      "special_cases": [
        "Digit 9 is sacred in Chaldean tradition and never assigned to individual letters, but compound sums can equal 9 or reduce to 9.",
        "Preserve compound totals across standard range (10 to 100+) without discarding compound interpretation."
      ],
      "output_schema": {
        "compound_total": "integer",
        "root_number": "integer",
        "letter_breakdown": "array of objects",
        "reduction_path": "array of integers"
      },
      "source_ids": [
        "B1",
        "B2"
      ],
      "source_pages": [
        "B2 Section 2",
        "B2 Section 7",
        "B2 Section 11"
      ],
      "status": "approved",
      "tests": [
        {
          "input": {
            "name": "Bhaskr Singh"
          },
          "expected": {
            "compound_total": 33,
            "root_number": 6
          }
        },
        {
          "input": {
            "name": "Elon Musk"
          },
          "expected": {
            "compound_total": 35,
            "root_number": 8
          }
        },
        {
          "input": {
            "name": "Victor"
          },
          "expected": {
            "compound_total": 22,
            "root_number": 4
          }
        }
      ]
    },
