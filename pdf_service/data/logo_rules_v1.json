    "TRADITIONAL_RULE": "Approved Numeros Vision traditional numerology or classical correlation table.",
    "NOT_CONFIGURED": "Rule or symbol concept intentionally left unconfigured pending domain owner approval; never guessed."
  },
  "client_palette_policy": {
    "rule_id": "CLIENT_PALETTE_POLICY_D6",
    "evidence_label": "TRADITIONAL_RULE",
    "allow_client_navy_and_black_when_chart_supports": true,
    "ui_chrome_restriction_applies_to_client_logos": false,
    "summary": "Client logo palettes follow the client's own numerology tables and category range (no blanket navy or black ban on client logos). Numeros Vision's Venus Pearl / Sandalwood Ink UI chrome palette applies only to site and report chrome."
  },
  "contrast_thresholds": {
    "rule_id": "WCAG21_LOGO_CONTRAST_V1",
    "evidence_label": "MEASURED",
    "symbol_and_large_text_min_ratio": 3.0,
    "small_text_min_ratio": 4.5,
    "large_text_definition": "24px regular (>=18pt) or 18.66px bold (>=14pt bold)",
    "explicit_pair_policies": [
      {
        "foreground_hex": "#C9A227",
        "background_hex": "#FFFDF7",
        "measured_ratio": 2.38,
        "allowed_for_symbol": false,
        "allowed_for_large_text": false,
        "allowed_for_small_text": false,
        "evidence_label": "MEASURED",
        "note": "#C9A227 on #FFFDF7 measures 2.38:1 and fails both 3.0:1 symbol/large-text and 4.5:1 small-text hard gates. Use #8B6914 (5.00:1) or #523E28 (9.93:1) on #FFFDF7."
      },
      {
        "foreground_hex": "#C9A227",
        "background_hex": "#523E28",
        "measured_ratio": 4.18,
        "allowed_for_symbol": true,
        "allowed_for_large_text": true,
        "allowed_for_small_text": false,
        "evidence_label": "MEASURED",
        "note": "#C9A227 on #523E28 measures 4.18:1 (>=3.0:1, <4.5:1): permitted ONLY for the symbol and large text; small text on #523E28 must use #FFFDF7 (9.93:1) or #F7F3EA (9.08:1)."
      }
    ]
  },
  "allowed_logo_types_v1": {
    "rule_id": "LOGO_TYPES_V1",
    "evidence_label": "MEASURED",
    "active_types": [
      "wordmark",
      "lettermark",
      "combination_mark",
      "emblem"
