    "conditional_types": {
      "pictorial_mark": "Permitted for existing-logo audit when all contours are closed and nothing is cut.",
      "abstract_mark": "Permitted for existing-logo audit when all contours are closed and nothing is cut."
    },
    "disabled_types": {
      "mascot": "NOT_CONFIGURED"
    }
  },
  "free_scan_verdict_rule": {
    "rule_id": "FREE_SCAN_VERDICT_V1",
    "evidence_label": "MEASURED",
    "states": {
      "Aligned": "All 9 hard gates pass AND zero enemy colour/number conflicts exist.",
      "Partly aligned": "Either at least 1 hard gate fails OR at least 1 enemy colour/number conflict exists, but NOT both.",
      "Not aligned": "At least 1 hard gate fails AND at least 1 enemy colour/number conflict exists."
    }
  },
